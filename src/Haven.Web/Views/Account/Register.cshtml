@model RegisterInput
@{ ViewData["Title"] = "Create account"; }
<section class="panel register-form"><p class="eyebrow">LET'S GET STARTED</p><h1>Create your account</h1><p class="muted">A simpler way to apply for and manage your next home.</p><form method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="username" /><span asp-validation-for="Email"></span></div>
<div class="field"><label asp-for="Role">I'm joining as</label><select asp-for="Role"><option value="Applicant">An applicant</option><option value="PropertyManager">A property manager</option></select><span asp-validation-for="Role"></span><small>Role selection is enabled for this assessment.</small></div>
<div class="field-row"><div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div><div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div></div><p class="hint">Use at least 10 characters, including uppercase, lowercase, a number, and a symbol.</p><button class="button full">Create account →</button></form><p class="hint">Already registered? <a asp-action="Login">Sign in</a></p></section>
