@model ApplicationList
@{ ViewData["Title"] = "Applications"; }
<section class="page-heading"><div><p class="eyebrow">@(User.IsInRole(Roles.Manager) ? "APPLICATION DESK" : "YOUR JOURNEY")</p><h1>Applications</h1><p class="muted">@(User.IsInRole(Roles.Manager) ? "Review applications and help residents take their next step." : "Pick up where you left off and follow your progress.")</p></div><a class="button secondary" asp-controller="Properties" asp-action="Index">Browse properties ↗</a></section>
@await Component.InvokeAsync("ApplicationStats")
<section class="panel"><form method="get" class="filters"><div class="field"><label asp-for="Status">Status</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()"><option value="">All statuses</option></select></div><div class="field"><label asp-for="PropertyId">Property</label><select asp-for="PropertyId" asp-items="Model.Properties"><option value="">All properties</option></select></div><div class="field"><label asp-for="Sort">Sort by</label><select asp-for="Sort"><option value="updated">Recently updated</option><option value="oldest">Oldest first</option><option value="name">Applicant name</option><option value="property">Property name</option></select></div><button class="button secondary">Apply filters</button></form>
<div class="table-wrap"><table><thead><tr><th>Application</th><th>Property / unit</th><th>Status</th><th>Updated</th><th><span class="sr-only">Open</span></th></tr></thead><tbody>
@foreach (var a in Model.Rows) { <tr><td><a class="table-link" asp-action="Edit" asp-route-id="@a.Id">@a.Name</a><small>#@a.Id.ToString("D5")</small></td><td>@a.Property<small>Unit @a.Unit</small></td><td><span class="badge @a.Status.ToString().ToLowerInvariant()">@a.Status</span></td><td>@a.UpdatedAt.ToString("MMM d, yyyy")</td><td><a class="text-link" asp-action="Edit" asp-route-id="@a.Id">Open →</a></td></tr> }
</tbody></table></div>
@if (Model.Rows.Count == 0) { <div class="empty"><h2>No applications found</h2><p>Try different filters or browse available apartments to begin.</p></div> }
<div class="pagination"><span>@Model.Total results · Page @Model.Page of @Model.PageCount</span><div>
@if (Model.Page > 1) { <a class="button secondary small" asp-route-page="@(Model.Page-1)" asp-route-status="@Model.Status" asp-route-propertyId="@Model.PropertyId" asp-route-sort="@Model.Sort">← Previous</a> }
@if (Model.Page < Model.PageCount) { <a class="button secondary small" asp-route-page="@(Model.Page+1)" asp-route-status="@Model.Status" asp-route-propertyId="@Model.PropertyId" asp-route-sort="@Model.Sort">Next →</a> }</div></div></section>
